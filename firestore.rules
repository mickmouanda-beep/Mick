rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Verrouillage strict de Firestore côté client :
    // L'application web communique exclusivement avec le serveur Node.js / Express (/api/*)
    // utilisant le SDK Firebase Admin. Tout accès direct du client Web/navigateur est rejeté (403/Permission Denied).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
