rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Establishments
    match /establishments/{establishmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // Users
    match /establishments/{establishmentId}/users/{userId} {
      allow read: if isSignedIn() && request.auth.token.establishment_id == establishmentId;
      allow write: if isSignedIn() && request.auth.token.establishment_id == establishmentId;
    }
  }
}
